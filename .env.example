# =========================================
# Chatwoot - Production .env
# =========================================

# Used to verify the integrity of signed cookies. Ensure a secure value is set.
# Must be alphanumeric (hex recommended)
SECRET_KEY_BASE=7f6a3e9c2b1d4a8e9f0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a

# Active Record Encryption keys (optional unless you will use MFA/2FA)
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# URL do seu Chatwoot
FRONTEND_URL=https://sinssistemas.cloud
# HELPCENTER_URL=https://sinssistemas.cloud

ASSET_CDN_HOST=

# Produção com HTTPS
FORCE_SSL=true

# Controle de cadastro
ENABLE_ACCOUNT_SIGNUP=false

# Redis (se estiver usando docker-compose com redis local, mantenha assim)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_SENTINELS=
REDIS_SENTINEL_MASTER_NAME=

# Postgres externo (a partir da sua URL)
POSTGRES_HOST=u880k0oggw08ok8os0wo8gkk
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=UCOVH721Up85MHEf9XvM5jFdIZ4JYTREpDs2n446VNfp0hRsagDkNUFsR5zdNMAs

# Ambiente Rails
RAILS_ENV=production
RAILS_MAX_THREADS=5

# Email (pode deixar assim por enquanto; para convites/reset de senha, configure SMTP)
MAILER_SENDER_EMAIL=Chatwoot <accounts@sinssistemas.cloud>
SMTP_DOMAIN=sinssistemas.cloud
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Mail Incoming (opcional)
MAILER_INBOUND_EMAIL_DOMAIN=
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=
MAILGUN_INGRESS_SIGNING_KEY=
MANDRILL_INGRESS_API_KEY=
ACTION_MAILBOX_SES_SNS_TOPIC=

# Storage
ACTIVE_STORAGE_SERVICE=local

# Amazon S3 (opcional)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Logs
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_SIZE=500

# Social channels (opcional)
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=
IG_VERIFY_TOKEN=
TWITTER_APP_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ENVIRONMENT=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=

# Mobile app (padrão)
IOS_APP_ID=L7YLMN4634.com.chatwoot.app
ANDROID_BUNDLE_ID=com.chatwoot.app
ANDROID_SHA256_CERT_FINGERPRINT=AC:73:8E:DE:EB:56:EA:CC:10:87:02:A7:65:37:7B:38:D4:5D:D4:53:F8:3B:FB:D3:C6:28:64:1D:AA:08:1E:D8

# Push relay (padrão)
ENABLE_PUSH_RELAY_SERVER=true

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DIRECT_UPLOADS_ENABLED=

# Azure OAuth (opcional)
AZURE_APP_ID=
AZURE_APP_SECRET=
